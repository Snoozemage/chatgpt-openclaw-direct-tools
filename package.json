{
  "name": "openclaw-direct-tools-for-chatgpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\setup.ps1",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\start.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\stop.ps1",
    "status": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\status.ps1",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tests\\smoke.ps1",
    "test:unit": "node --test .\\tests\\*.test.mjs",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tests\\check-syntax.ps1",
    "test:credential-store": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tests\\windows-credential-store.ps1"
  },
  "engines": {
    "node": ">=22.17"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "diff": "8.0.4",
    "diff2html": "3.4.56",
    "json-formatter-js": "2.5.23"
  }
}
